# Copy to .env and set values. Used by docker-compose or your shell; server reads os.environ.
# PORT=5001
# CORS_ORIGINS=*
# FLASK_ENV=development
# ADMIN_KEY=your-admin-secret
# DATABASE_PATH=data/community.db
# GENEALOGY_DB_PATH=data/genealogy.db   # Optional; default is data/genealogy.db
# SAVE_TO_DISK=1   # Optional: also write saved patterns to output/saved/ (local dev)
